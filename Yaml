name: Build APK NEXUSMIDI PRO
on:
  push:
    branches: [ main, master ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Baixar código
        uses: actions/checkout@v4

      - name: Verificar arquivos do projeto
        run: |
          echo "=== Arquivos na raiz ==="
          ls -la
          echo "=== Procurando arquivos gradle ==="
          find . -name "build.gradle" -o -name "gradlew" 2>/dev/null || echo "Nenhum encontrado"

      - name: Instalar Java 17
        uses: actions/setup-java@v5
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: Gerar Gradle Wrapper se não existir
        run: |
          if [ ! -f ./gradlew ]; then
            echo "Criando arquivos do Gradle..."
            sudo apt update && sudo apt install -y gradle
            gradle wrapper
          fi

      - name: Permitir execução
        run: chmod +x ./gradlew

      - name: Montar APK
        run: ./gradlew assembleDebug --no-daemon

      - name: Disponibilizar APK
        uses: actions/upload-artifact@v4
        with:
          name: NEXUSMIDI-PRO
          path: app/build/outputs/apk/debug/app-debug.apk

