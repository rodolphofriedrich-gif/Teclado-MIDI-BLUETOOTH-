{
  "name": "nexusmidi-pro",
  "private": true,
  "version": "1.0.0",
  "description": "Hub MIDI e sintetizador SoundFont para Android e Web (USB, Bluetooth LE, roteador, gravador e arpejador).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:android": "vite build --mode android",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"*.{json,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"*.{json,ts}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "cap:sync": "npm run build:android && cap sync android",
    "android:debug": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/share": "^8.0.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "spessasynth_lib": "^4.3.14"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.0.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.0"
  }
}
